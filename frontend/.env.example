# Copy this file to `.env` (in frontend/) and fill in the deployed addresses.
# Every variable must start with VITE_ to be readable from the browser bundle.

# --- Deployed contracts (printed by scripts/deploy.js) -----------------------
VITE_MST_ADDRESS=
VITE_ERC20_HTLC_ADDRESS=
VITE_ETH_HTLC_ADDRESS=

# --- Read-only RPC endpoints for the chain the wallet is NOT connected to ---
# These are only used to read the counterparty leg; transactions always go through MetaMask.
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# --- Default timelock offsets (seconds) ------------------------------------
# The ETH leg is claimed first, so it must be strictly shorter than the MST leg.
VITE_ETH_TIMELOCK_SECONDS=900
VITE_ERC20_TIMELOCK_SECONDS=1800

# --- Optional: pre-fill the demo counterparty address ----------------------
VITE_COUNTERPARTY_ADDRESS=
